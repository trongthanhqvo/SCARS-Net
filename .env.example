# Optional shell path template; the Python runner does not auto-load this file.
# Copy to .env, edit, and source it in your shell if desired. Never commit .env.
export SCARS_DRONERFA_DIR="/path/to/DroneRFa"
export SCARS_DRONERFB_DIR="/path/to/twin_droneRF"
export SCARS_DRFF_R2_DIR="/path/to/DRFF-R2"
export SCARS_RUN_DIR="/path/to/local-ssd/scars-run"
# SCARS_LOCAL_DATASET_ROOT is intentionally unset: tests must not discover real data.
